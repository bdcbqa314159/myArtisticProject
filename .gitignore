# macOS
.DS_Store

# secrets
.env
.env.*

# pictures taken by tools/render-check.py
/render-shots/

# build output (zola)
/public/

# zola writes resized images here during the build
/static/processed_images/

# Source maps are a developer's convenience. The .js files themselves ARE
# committed — see "Why the compiled JS is in the repo" in README.
/static/js/*.js.map

node_modules/

# ---------------------------------------------------------------
# CLIENT MATERIAL — never commit. Briefs, decks, mood boards and design
# sources belong to the client. They live in _ref/, local only.
# ---------------------------------------------------------------
/_ref/
*.pdf
# NO EXCEPTION for content/. There was one, and it was a trap: Zola
# copies everything under content/ into the built site, so a PDF left
# there would be published and downloadable — the one thing a dossier
# exists to prevent. `tools/objects.py` refuses it too; this makes it
# impossible to commit in the first place.
*.ai
*.psd
*.sketch
*.fig
*.indd
*.afdesign
*.afphoto

# where the client drops material before it is placed in content/
/_client_input/

# ---------------------------------------------------------------
# THE REAL CONTENT, AND THE PREVIEW BUILT FROM IT.
#
# _dropin/ is where his names, photographs and showreel go; _local/ is
# the site assembled from them. Both are ignored, and that is the whole
# mechanism keeping client material out of a public repository — see
# tools/dropin.py. The tracked tree keeps the placeholders and stays
# publishable.
# ---------------------------------------------------------------
/_dropin/
/_local/

# The spec quotes the brief and names the client. It lives in _ref/
# with the other client-derived documents.
/specs/

