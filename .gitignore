# macOS
.DS_Store

# secrets
.env
.env.*

# pictures taken by tools/render-check.py
/render-shots/

# build output (zola)
/public/

# zola writes resized images here during the build
/static/processed_images/

# Source maps are a developer's convenience. The .js files themselves ARE
# committed — see "Why the compiled JS is in the repo" in README.
/static/js/*.js.map

node_modules/

# ---------------------------------------------------------------
# CLIENT MATERIAL — never commit. Briefs, decks, mood boards and design
# sources belong to the client. They live in _ref/, local only.
# ---------------------------------------------------------------
/_ref/
*.pdf
# NO EXCEPTION for content/. There was one, and it was a trap: Zola
# copies everything under content/ into the built site, so a PDF left
# there would be published and downloadable — the one thing a dossier
# exists to prevent. `tools/objects.py` refuses it too; this makes it
# impossible to commit in the first place.
*.ai
*.psd
*.sketch
*.fig
*.indd
*.afdesign
*.afphoto

# where the client drops material before it is placed in content/
/_client_input/

# THEIR MARK. The real logo is the brand itself, and the brand in this
# repository is a stand-in — so a committed logo.svg would say in one
# file what every other file is careful not to. The panel writes these
# three when it is run at the repository root, and `tools/icons.py`
# turns them into the published favicon, touch icon and share image, so
# without these lines a drop would leave the client's mark untracked in
# a PUBLIC checkout, one `git add -A` from being published. The real
# ones arrive through _dropin/static/ and are assembled into _local/.
/static/logo.svg
/static/logo.png
/static/share.png

# THEIR TYPEFACE. A licensed webfont is somebody else's property and a
# public repository is the one place it must not be — most foundry
# licences forbid redistribution outright, and a committed woff2 is
# redistribution. The generated static/css/fonts.css IS tracked: it
# names a family and a path, which is not the font. The files arrive
# through _dropin/static/fonts/ and are assembled into _local/.
/static/fonts/

# THE SHOWREEL. Their film, and the largest single thing they will hand
# over. The studio panel writes it here when it is run at the repository
# root, so without this line a drop would leave a client's film sitting
# untracked in a PUBLIC checkout, one `git add -A` from being published.
# The tracked tree has never held one: the real film arrives through
# _dropin/static/video/ and is assembled into _local/, both ignored.
/static/video/

# ---------------------------------------------------------------
# THE REAL CONTENT, AND THE PREVIEW BUILT FROM IT.
#
# _dropin/ is where their names, photographs and showreel go; _local/ is
# the site assembled from them. Both are ignored, and that is the whole
# mechanism keeping client material out of a public repository — see
# tools/dropin.py. The tracked tree keeps the placeholders and stays
# publishable.
# ---------------------------------------------------------------
/_dropin/
/_local/

# The spec quotes the brief and names the client. It lives in _ref/
# with the other client-derived documents.
/specs/

